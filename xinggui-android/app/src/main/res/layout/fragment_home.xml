<?xml version="1.0" encoding="utf-8"?>
<!--
  P6 首页。上层固定搜索栏（view_home_sticky_bar 原样复用），
  下面 NestedScrollView 依次是：功能入口 + 榜单卡 + 热门歌单 + 新歌速递列表。
  与 activity_main 原版的关系：区块顺序与间距保留，从「平铺 + setVisibility」改成
  可滚动容器 + RecyclerView 承载列表。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <include
        android:id="@+id/homeStickyHeader"
        layout="@layout/view_home_sticky_bar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/homeHeader"
                layout="@layout/view_home_header" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNewSongs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/tvHomeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="18dp"
                android:text=""
                android:textColor="@color/ink_400"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>