<?xml version="1.0" encoding="utf-8"?>
<!--
  注册页。表单与「等待审核」结果共用一个 Activity 的两个根容器：
  注册成功把表单整体藏起来、只留一个不可跳过的等待页，
  避免用户按返回键回到表单重复提交、也避免误入主界面。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_sunken">

    <!-- ============ 表单 ============ -->
    <ScrollView
        android:id="@+id/registerFormScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="40dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/register_title"
                android:textColor="@color/ink_900"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/register_subtitle"
                android:textColor="@color/ink_500"
                android:textSize="13sp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/auth_username_label"
                        android:textColor="@color/ink_700"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etRegisterUsername"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:autofillHints="newUsername"
                        android:background="@drawable/bg_search_round_48"
                        android:hint="@string/auth_username_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textNoSuggestions"
                        android:maxLength="32"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="@color/ink_900"
                        android:textColorHint="@color/ink_400"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/auth_password_label"
                        android:textColor="@color/ink_700"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etRegisterPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:autofillHints="newPassword"
                        android:background="@drawable/bg_search_round_48"
                        android:hint="@string/auth_password_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:maxLength="64"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="@color/ink_900"
                        android:textColorHint="@color/ink_400"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/register_confirm_label"
                        android:textColor="@color/ink_700"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etRegisterConfirm"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:autofillHints="newPassword"
                        android:background="@drawable/bg_search_round_48"
                        android:hint="@string/register_confirm_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLength="64"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="@color/ink_900"
                        android:textColorHint="@color/ink_400"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvRegisterError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/danger"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="18dp">

                        <TextView
                            android:id="@+id/btnRegisterSubmit"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_btn_solid_blue"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="@string/register_submit"
                            android:textColor="@color/on_brand"
                            android:textSize="15sp" />

                        <ProgressBar
                            android:id="@+id/pbRegisterSubmit"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/btnRegisterGoLogin"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="?android:selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/register_go_login"
                        android:textColor="@color/brand"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- ============ 等待审核 ============ -->
    <LinearLayout
        android:id="@+id/registerPendingPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_sunken"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_account_vip_card">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/auth_logo_desc"
                android:src="@drawable/ic_vip_shield"
                app:tint="@color/on_brand" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvPendingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/register_pending_title"
            android:textColor="@color/ink_900"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvPendingDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/register_pending_desc"
            android:textColor="@color/ink_500"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvPendingUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_btn_pill_white"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:textColor="@color/brand"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnPendingBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="26dp"
            android:background="?android:selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/register_back_to_login"
            android:textColor="@color/brand"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
