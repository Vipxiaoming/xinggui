<?xml version="1.0" encoding="utf-8"?>
<!--
  P6 搜索页。顶部是搜索输入 + 四平台切换；下方直接承载 view_search_result_page 的
  结果区（原版该布局是 gone + 由代码切 visible，这里同样在 Fragment 里切换）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_sunken"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/searchTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnSearchBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:background="?android:selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="@string/action_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_search_light"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search_line"
                android:tint="@color/ink_400" />

            <EditText
                android:id="@+id/etSearchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="搜索歌曲、歌手、专辑"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/ink_900"
                android:textColorHint="@color/ink_400"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnSearchClear"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_remove_close"
                android:tint="@color/ink_400"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSearchGo"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:text="搜索"
            android:textColor="@color/brand"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layoutPlatformChips"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:weightSum="4" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/line" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/searchResultPage"
            layout="@layout/view_search_result_page" />

        <TextView
            android:id="@+id/tvSearchEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="输入关键词后回车，四家平台并发检索"
            android:textColor="@color/ink_400"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/pbSearchLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>