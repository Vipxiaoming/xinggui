<?xml version="1.0" encoding="utf-8"?>
<!--
  P6 全屏播放器（原版 activity_main.full.xml 的 fullscreenPlayerView 段 1:1 迁移）。
  与主界面的关系：以 Fragment 覆盖在 MainActivity 内容区之上，关闭即移除；
  mini player 长按/点击封面进入。
  视觉保持：260dp 黑胶 + 唱臂 + 160dp 圆形封面 + 双行歌词 + 5 键控制。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player_light_gradient"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:id="@+id/fullTopBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnCloseFull"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="收起播放器"
            android:padding="8dp"
            android:src="@drawable/ic_player_down"
            android:tint="@color/ink_900" />

        <TextView
            android:id="@+id/tvPlayerSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text=""
            android:textColor="@color/ink_400"
            android:textSize="12sp" />

        <!-- 歌词模式开关：原版只有「点封面进歌词」，没有显式入口；这里补一个文字按钮，
             不新增 drawable，避免与图标阶段冲突。 -->
        <TextView
            android:id="@+id/btnFullLyric"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/player_lyric"
            android:textColor="@color/ink_700"
            android:textSize="13sp" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/centerModeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/playerBottomControl"
        android:layout_below="@id/fullTopBar">

        <RelativeLayout
            android:id="@+id/viewVinylMode"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:id="@+id/vinylDiscContainer"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_vinyl_disc">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/fullAlbumCover"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_centerInParent="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_album_default"
                    app:shapeAppearanceOverlay="@style/CircleImageViewStyle" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/lyricContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_below="@id/vinylDiscContainer"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:id="@+id/fullSongTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="sans-serif-medium"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="星轨音乐"
                    android:textColor="@color/ink_900"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/fullArtistTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="随心而动"
                    android:textColor="@color/ink_500"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvLyricCurrent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text=""
                    android:textColor="@color/brand"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvLyricNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.85"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text=""
                    android:textColor="@color/ink_500"
                    android:textSize="13sp" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/playerBottomControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnVinylLike"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:contentDescription="收藏"
                    android:padding="8dp"
                    android:src="@drawable/ic_vinyl_like" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnVinylDownload"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:contentDescription="下载"
                    android:padding="8dp"
                    android:src="@drawable/ic_vinyl_download" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnVinylAlarm"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:contentDescription="定时关闭"
                    android:padding="8dp"
                    android:src="@drawable/ic_vinyl_alarm" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnVinylComment"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:contentDescription="评论"
                    android:padding="8dp"
                    android:src="@drawable/ic_vinyl_comment" />
            </FrameLayout>
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/fullSeekBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:progressDrawable="@drawable/progress_bar_custom"
                android:thumb="@drawable/seek_thumb" />

            <TextView
                android:id="@+id/tvTimeCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_below="@id/fullSeekBar"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:text="00:00"
                android:textColor="@color/ink_500"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTimeDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_below="@id/fullSeekBar"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="4dp"
                android:text="00:00"
                android:textColor="@color/ink_500"
                android:textSize="12sp" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="5">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnFullPlayMode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:contentDescription="@string/play_mode_sequential"
                    android:padding="12dp"
                    android:src="@drawable/ic_play_mode_loop"
                    android:tint="@color/ink_900" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnFullPrev"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:contentDescription="上一首"
                    android:padding="12dp"
                    android:src="@drawable/ic_player_prev"
                    android:tint="@color/ink_900" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnFullPlayPause"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mini_play"
                    android:padding="10dp"
                    android:src="@drawable/ic_player_play_line" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnFullNext"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:contentDescription="下一首"
                    android:padding="12dp"
                    android:src="@drawable/ic_player_next"
                    android:tint="@color/ink_900" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnFullPlaylist"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mini_playlist"
                    android:padding="12dp"
                    android:src="@drawable/ic_playlist_menu"
                    android:tint="@color/ink_900" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>