<?xml version="1.0" encoding="utf-8"?>
<!--
  我的喜欢（收藏列表）。P6 遗留功能接线。
  复用 item_song 的单曲行；顶部为返回 + 标题 + 实时计数（计数来自 Room Flow，
  不在 UI 另存一份，取消收藏后立即同步）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_sunken"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBackFavorites"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/ink_900" />

        <TextView
            android:id="@+id/tvFavoritesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnBackFavorites"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="我的喜欢"
            android:textColor="@color/ink_900"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvFavoritesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="0 首"
            android:textColor="@color/ink_500"
            android:textSize="12sp" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/line" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFavorites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:id="@+id/layoutFavoritesEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.35"
                android:contentDescription="暂无收藏"
                android:src="@drawable/ic_vinyl_liked" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="还没有收藏的歌曲\n在列表或播放器点一下心形即可收藏"
                android:textColor="@color/ink_400"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
