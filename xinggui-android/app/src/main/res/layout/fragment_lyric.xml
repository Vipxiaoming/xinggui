<?xml version="1.0" encoding="utf-8"?>
<!--
  全屏歌词（P6 遗留功能）。
  覆盖在播放器 centerModeContainer 之上：顶部保留歌名与关闭按钮，
  中间是整屏歌词列表，底部用一行提示说明「点击跳转 / 上下拖拽浏览」。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lyricRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:id="@+id/lyricTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btnLyricClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="收起歌词"
            android:padding="8dp"
            android:src="@drawable/ic_player_down"
            android:tint="@color/ink_900" />

        <TextView
            android:id="@+id/tvLyricTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/ink_900"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvLyricTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:paddingEnd="6dp"
            android:text=""
            android:textColor="@color/ink_400"
            android:textSize="12sp" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLyric"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/lyricBottomHint"
        android:layout_below="@id/lyricTopBar"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/tvLyricEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:text="该曲目暂无歌词"
        android:textColor="@color/ink_400"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lyricBottomHint"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="点击任意一行跳转播放 · 上下拖拽浏览"
        android:textColor="@color/ink_400"
        android:textSize="11sp" />
</RelativeLayout>