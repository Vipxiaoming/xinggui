<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 源码集生效（同名资源覆盖 main，release 不受影响）。

  与 main 版本保持一致：真机联调需要在 App 内自填服务端地址，
  局域网 http 域名无法预先枚举，所以 base-config 放开明文；
  生产域名仍单独钉死 cleartextTrafficPermitted="false"。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">music.wangxiaoming.vip</domain>
    </domain-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">mobilecdn.kugou.com</domain>
        <domain includeSubdomains="false">mobilecdnbj.kugou.com</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>