# ============================================================
# Docker 构建上下文排除清单
# 目的：镜像里绝不出现用户数据、密钥、Windows 二进制、证书。
# ============================================================

# ---- 数据目录（含 SQLite 库 / jwt.secret / *.token-*）----
data/
data*/
**/data/
**/data*/

# ---- 密钥与令牌 ----
jwt.secret
**/jwt.secret
*.token-*
*.p9-admin-token
.token-it
.token-user-it

# ---- 数据库文件 ----
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---- 证书与私钥 ----
certs/
**/certs/
*.pem
*.key
*.crt
*.cer
*.der
*.p7b
*.pfx
*.p12
*.jks

# ---- Windows 二进制与备份 ----
*.exe
*.exe~
*.exe.*
*.bak
*.bak-*
*.dll
*.so
*.apk

# ---- 本地脚本 / 抓包 / 调试残留 ----
chrome-p6/
chrome-*/
*.log
selftest-output.txt
p8-setup.json
run-p8.ps1
selftest.ps1
selftest2.ps1

# ---- VCS / 编辑器 ----
.git/
.gitignore
.dockerignore
.idea/
.vscode/
*.iml

# ---- 文档不参与构建 ----
SELFTEST.md