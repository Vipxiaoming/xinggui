xinggui-server/chrome-*/
xinggui-server/*.bak
xinggui-server/*.bat
xinggui-server/selftest-output.txt
xinggui-server/p8-setup.json

# ---------- 分析报告（体积大且含内部路径/细节，不进仓库） ----------
aurora-music-analysis/

# ---------- 编辑器 / 操作系统 ----------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

